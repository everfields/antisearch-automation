# Copy to .env (gitignored) or set as CI / Cloud Agent secrets. Every value is
# optional: without them the mill still produces clips and dry-runs publishing.
# See SETUP.md for where each one comes from.

# --- oracle / mill -----------------------------------------------------------
ANTISEARCH_ORACLE_URL=https://antisearch.ai/verdict
MILL_OUT_DIR=out
# MILL_FONT=/usr/share/fonts/opentype/inter/Inter-Regular.otf
# MILL_CLIP_SECONDS=3.8
# MILL_ORACLE_MIN_INTERVAL_S=1.5
# MILL_ORACLE_RATE_LIMIT_WAIT_S=60

# --- X (live-capable). Preferred: OAuth 1.0a user context (non-expiring) -----
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Alternative: OAuth 2.0 user token (expires ~2h; manual runs only)
# X_OAUTH2_ACCESS_TOKEN=

# --- LinkedIn (live-capable) -------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
# urn:li:organization:<company page id>  or  urn:li:person:<member id>
LINKEDIN_AUTHOR_URN=
# LINKEDIN_VERSION=202609

# --- TikTok / Instagram (legacy `mill publish`: drafts only; own publisher: live) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- own publisher (`mill post`); every step in docs/PUBLISHER_SETUP.md -------
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REFRESH_TOKEN=
TIKTOK_REFRESH_TOKEN=
# TIKTOK_MODE=inbox
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# INSTAGRAM_GRAPH_VERSION=v24.0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# REDDIT_SUBREDDIT=u_antisearch
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
# PUBLISHER_PUBLIC_BASE_URL=     # Threads/Instagram pull media from here
# PUBLISHER_LIVE_NETWORKS=       # e.g. bluesky,linkedin: the recorded first-of-class yes
# PUBLISHER_DAILY_CAP=2          # 0..2 during the trial
# PUBLISHER_STATE=state/posts.csv
# PUBLISHER_TZ=Europe/Madrid
# PUBLISHER_OAUTH_REDIRECT_URI=https://antisearch.ai/
