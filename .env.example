# Copy to .env (gitignored) or set as CI / Cloud Agent secrets. Every value is
# optional: without them the mill still produces clips and dry-runs publishing.
# See SETUP.md for where each one comes from.

# --- oracle / mill -----------------------------------------------------------
ANTISEARCH_ORACLE_URL=https://antisearch.ai/verdict
MILL_OUT_DIR=out
# MILL_FONT=/usr/share/fonts/opentype/inter/Inter-Regular.otf
# MILL_CLIP_SECONDS=3.8
# MILL_ORACLE_MIN_INTERVAL_S=1.5
# MILL_ORACLE_RATE_LIMIT_WAIT_S=60

# --- X (live-capable). Preferred: OAuth 1.0a user context (non-expiring) -----
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Alternative: OAuth 2.0 user token (expires ~2h; manual runs only)
# X_OAUTH2_ACCESS_TOKEN=

# --- LinkedIn (live-capable) -------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
# urn:li:organization:<company page id>  or  urn:li:person:<member id>
LINKEDIN_AUTHOR_URN=
# LINKEDIN_VERSION=202609

# --- TikTok / Instagram (stubs today: drafts only, values unused) ------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
