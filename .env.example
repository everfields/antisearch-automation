# Copy to .env (gitignored) or set as CI / Cloud Agent secrets. Every value is
# optional: without them the mill still produces clips and dry-runs publishing.
# See SETUP.md for where each one comes from.

# --- oracle / mill -----------------------------------------------------------
ANTISEARCH_ORACLE_URL=https://antisearch.ai/verdict
MILL_OUT_DIR=out
# MILL_FONT=/usr/share/fonts/opentype/inter/Inter-Regular.otf
# MILL_CLIP_SECONDS=3.8
# MILL_ORACLE_MIN_INTERVAL_S=1.5
# MILL_ORACLE_RATE_LIMIT_WAIT_S=60

# --- X (live-capable). Preferred: OAuth 1.0a user context (non-expiring) -----
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Alternative: OAuth 2.0 user token (expires ~2h; manual runs only)
# X_OAUTH2_ACCESS_TOKEN=

# --- LinkedIn (live-capable) -------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
# urn:li:organization:<company page id>  or  urn:li:person:<member id>
LINKEDIN_AUTHOR_URN=
# LINKEDIN_VERSION=202609

# --- TikTok / Instagram (legacy `mill publish`: drafts only; own publisher: live) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- own publisher (`mill post`); every step in docs/PUBLISHER_SETUP.md -------
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# BLUESKY_SERVICE=https://bsky.social
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REFRESH_TOKEN=
TIKTOK_REFRESH_TOKEN=
# TIKTOK_MODE=inbox
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# INSTAGRAM_GRAPH_VERSION=v24.0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# REDDIT_SUBREDDIT=u_antisearch
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
# PUBLISHER_LIVE_NETWORKS=       # e.g. bluesky,instagram,linkedin,tiktok: the recorded first-of-class yes
# PUBLISHER_STATE=state/posts.csv
# PUBLISHER_CADENCE=carlos              # carlos (5 everywhere, x 2) or soul (tiktok 5, x 2, bluesky 3, instagram 3, linkedin 1)
# PUBLISHER_X_FORMAT=alternate           # X format A/B: alternate (default), video, or text
# PUBLISHER_TAG_NETWORKS=                # winner tags: instagram,tiktok; empty = off (queue/tags/README.md)
# PUBLISHER_SLOTS_INSTAGRAM=19:07        # HH:07 America/New_York, max 5, >=90 min apart, or off
# PUBLISHER_LANGUAGE=en                  # English lock; anything else lifts the input check
# PUBLISHER_CLIP_STYLE=word              # word (default) or app
# PUBLISHER_CLIP_AUDIO=off               # off (default), keys, pulse, or heartbeat; Instagram/TikTok only
# PUBLISHER_CLIP_AUDIO_VARIANT=c         # pulse only: a, b, or c (default)
# PUBLISHER_CLIP_AUDIO_BED=off           # heartbeat only: on adds a very quiet low drone under the wait
# PUBLISHER_CLIP_KEYS_SOUND=soft         # keys only: soft (default) or muted
# PUBLISHER_CLIP_FRAME=none              # none (default) or phone (implies the app screen)
# PUBLISHER_CLIP_PHONE_SCALE=0.80        # phone height over video height, 0.60-0.95
# PUBLISHER_CLIP_PHONE_BG=stone          # stone (default), bone, sage, black, or gradient
# PUBLISHER_ROUTE_TIKTOK=buffer          # buffer (default for instagram/linkedin/tiktok) or direct
# BUFFER_API_KEY=
# BUFFER_CHANNEL_INSTAGRAM=
# BUFFER_CHANNEL_LINKEDIN=
# BUFFER_CHANNEL_TIKTOK=
# PUBLISHER_MEDIA_REPO=everfields/antisearch-clips
# PUBLISHER_MEDIA_TOKEN=
# PUBLISHER_PUBLIC_BASE_URL=https://everfields.github.io/antisearch-clips
# PUBLISHER_OAUTH_REDIRECT_URI=https://antisearch.ai/
